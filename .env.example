# Copy to .env and fill in. Never commit .env.

# ── GitHub workspace sync ─────────────────────────────────────────────────────
# A PRIVATE repo that receives %APPDATA%\ABAP_AI\workspace (your Z*/Y* sources).
GITHUB_REPO=https://github.com/<user>/<private-workspace-repo>
# Fine-grained token: Repository access = that repo, Permissions → Contents: Read and write
# (or a classic token with the 'repo' scope)
GITHUB_TOKEN=

# ── Optional: SAP fallback for the MCP server ─────────────────────────────────
# Only used when no profile exists in %APPDATA%\ABAP_AI\systems.json.
# SAP_ASHOST=
# SAP_SYSNR=00
# SAP_CLIENT=100
# SAP_USER=
# SAP_PASSWD=
# SAP_ROUTER=

# ── Optional: pick the MCP server's startup profile by name ───────────────────
# SAP_PROFILE=
